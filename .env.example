# Copy to .env (or set in the parent poc/.env) and fill in.
# Nothing here is read at import time except via app/config.py.

# --- LLM -------------------------------------------------------------------
API_KEY=sk-your-genailab-key
LLM_BASE_URL=https://genailab.tcs.in
LLM_MODEL_MINI=azure/genailab-maas-gpt-4.1-mini
LLM_MODEL_PRIMARY=azure/genailab-maas-gpt-4.1
LLM_MODEL_FALLBACK=genailab-maas-sonnet-4.6
LLM_MODEL_EMBEDDING=azure/genailab-maas-text-embedding-3-large
LLM_TIMEOUT_SECONDS=60
LLM_VERIFY_SSL=false
# Set false to demo graceful degradation (template mode).
LLM_ENABLED=true

# --- security --------------------------------------------------------------
JWT_SECRET=change-me-in-any-real-deployment
JWT_TTL_SECONDS=3600
FIELD_ENCRYPTION_KEY=change-me-too

# --- storage ---------------------------------------------------------------
# DB_PATH=data/claimcompanion.db
# BLOB_DIR=data/blobs

# --- limits ----------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=30
MAX_TURN_HOPS=3
MAX_UPLOAD_BYTES=10485760
RAG_RELEVANCE_FLOOR=0.12
