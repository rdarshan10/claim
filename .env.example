# Copy to .env (or set in the parent poc/.env) and fill in.
# Nothing here is read at import time except via app/config.py.

# --- LLM -------------------------------------------------------------------
# Which provider serves requests at startup. The staff/portal model switch can
# change it live; a restart comes back to whatever is set here.
LLM_PROVIDER=groq

# --- Groq (OpenAI-compatible chat completions) ---
GROQ_API_KEY=gsk_your-groq-key
LLM_BASE_URL=https://api.groq.com

# --- GenAI Lab (optional second provider) ---
# Only needed to switch to it. Its certificate does not validate, which the
# provider handles itself — don't set LLM_VERIFY_SSL=false for this.
# GENAILAB_API_KEY=sk-your-genailab-key
# GENAILAB_BASE_URL=https://genailab.tcs.in
LLM_MODEL_MINI=openai/gpt-oss-20b
LLM_MODEL_PRIMARY=openai/gpt-oss-120b
LLM_MODEL_FALLBACK=openai/gpt-oss-20b
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60
LLM_VERIFY_SSL=true
# Set false to demo graceful degradation (template mode).
LLM_ENABLED=true

# --- security --------------------------------------------------------------
JWT_SECRET=change-me-in-any-real-deployment
JWT_TTL_SECONDS=3600
FIELD_ENCRYPTION_KEY=change-me-too

# --- storage ---------------------------------------------------------------
# DB_PATH=data/claimcompanion.db
# BLOB_DIR=data/blobs

# --- limits ----------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=30
MAX_TURN_HOPS=3
MAX_UPLOAD_BYTES=10485760
RAG_RELEVANCE_FLOOR=0.12
